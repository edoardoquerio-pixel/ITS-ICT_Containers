# === Database ===
# Tipo di database: "sqlite" (default) o "postgres"
DATABASE_TYPE=sqlite

# SQLite (usato solo se DATABASE_TYPE=sqlite)
DATABASE_PATH=/data/books.db

# PostgreSQL (usato solo se DATABASE_TYPE=postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/books

# === Server ===
HOST=0.0.0.0
PORT=8000

# === Logging ===
LOG_LEVEL=INFO
